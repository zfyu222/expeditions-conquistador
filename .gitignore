# 游戏目录（目录联接/junction，指向外部游戏安装目录，不纳入版本控制）
/Game/

# 备份与中间产物
*.bak
*.bak0000
*.tmp

# Python
__pycache__/
*.pyc

# 系统/编辑器
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# 可重建的资源导出、反编译结果与运行日志
/Analysis/textassets/
/Analysis/mono/
/Analysis/decompiled/
/Analysis/narrative/
/Analysis/input/
/Analysis/*.log

# 翻译缓存、备份与凭据
/TranslateFiles/cache/
/TranslateFiles/backups/
.env
.env.*

# Reproducible repack outputs and original game backups
/Repack/Build/
/Repack/Backup/
/Repack/Tools/
/Repack/Scripts/Patcher/obj/
/Dispatch/
/Analysis/tutorial_images/
/TranslateFiles/tutorial_supplement/tasks/
/TranslateFiles/tutorial_supplement/results/
/TranslateFiles/tutorial_supplement/review_format_issues_*.json
